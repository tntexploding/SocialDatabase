# Private input and generated databases
/data/input/*
!/data/input/.gitkeep
/data/database/*
!/data/database/.gitkeep
*.db
*.sqlite
*.sqlite3

# Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class

# Test and tooling output
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Packaging output
build/
dist/
*.egg-info/

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Temporary and log files
*.log
*.tmp
*.temp
*.bak
